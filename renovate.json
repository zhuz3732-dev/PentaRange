{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommits"],
  "timezone": "Asia/Shanghai",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "baseBranches": ["main"],
  "packageRules": [
    {
      "description": "Base images and pip pins in a lab image only need a weekly look.",
      "matchManagers": ["dockerfile", "pip_requirements"],
      "groupName": "lab base image and python deps",
      "automerge": false
    },
    {
      "description": "GitHub Actions are safe to bump automatically once CI is green.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false
  }
}